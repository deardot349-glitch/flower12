# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/flower_saas?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://yourdomain.com"

# ── Admin panel access ────────────────────────────────────────────────────────
# The query param value required to access /admin  e.g. /admin?_a=YOUR_ADMIN_SECRET
# Generate a strong random value: openssl rand -hex 16
ADMIN_SECRET="your-admin-secret-here"

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
FROM_EMAIL="FlowerGoUa <hello@yourdomain.com>"

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_WEBHOOK_SECRET="your-webhook-secret"

# ── Cron security ────────────────────────────────────────────────────────────
# Used to authenticate Vercel Cron requests
# Generate with: openssl rand -hex 16
CRON_SECRET="your-cron-secret"

# ── Rate limiting (optional — Upstash Redis) ──────────────────────────────────
# Get from https://console.upstash.com
# When not set, in-memory rate limiting is used (not suitable for multi-instance)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
